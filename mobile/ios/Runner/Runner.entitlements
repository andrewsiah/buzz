<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SNACK: the first native TestFlight ships without push, app groups, App
	     Attest or declared age range: the app.wesnack.ios App ID has none of
	     those capabilities yet, and the Notification Service extension is not
	     embedded. Buzz's full list is in this file's git history. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(BUZZ_KEYCHAIN_ACCESS_GROUP)</string>
	</array>
</dict>
</plist>
